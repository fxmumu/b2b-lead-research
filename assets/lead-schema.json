{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2B Lead",
  "type": "object",
  "properties": {
    "company": { "type": "string", "minLength": 1 },
    "country": { "type": "string", "minLength": 1 },
    "website": {
      "type": "string",
      "description": "官网 URL；去重主键优先用其域名"
    },
    "stage": {
      "type": "string",
      "enum": ["discovered", "screened", "diligenced", "verified", "scored"],
      "description": "流水线进度。续跑时按此字段跳过已完成阶段，只补下一阶段"
    },
    "disposition": {
      "type": "string",
      "enum": ["pending", "main", "backup", "competitor", "unreachable", "excluded"],
      "description": "去向。pending=仍在流水线；main/backup=交付名单（仅 scored 且参与打分）；其余为排除类，不占 backup_n 名额"
    },
    "exclusion_reason": {
      "type": "string",
      "description": "disposition 为 competitor / unreachable / excluded 时必填：一句话说明原因"
    },
    "segment": {
      "type": "string",
      "enum": [
        "end_user",
        "epc",
        "installer",
        "distributor",
        "importer",
        "trading_company",
        "oem_buyer",
        "developer_owner"
      ],
      "description": "客户类型标准键名（见 segmentation.md）；screened 及之后必填（competitor 除外可省略）"
    },
    "match_reason": { "type": "string" },
    "segment_evidence": {
      "type": "array",
      "description": "支撑供需判定（为何判为需方而非同行）的证据，每条含观察到的信号与来源 URL",
      "items": {
        "type": "object",
        "properties": {
          "signal": {
            "type": "string",
            "enum": ["demand_side", "supply_side"],
            "description": "该条证据指向需求侧还是供给侧"
          },
          "observation": {
            "type": "string",
            "description": "观察到的具体事实，如：官网产品页含多品牌产品线、招聘安装工程师等"
          },
          "source": { "type": "string", "format": "uri" }
        },
        "required": ["signal", "observation", "source"]
      }
    },
    "due_diligence_checks": {
      "type": "array",
      "description": "背调 5 个检查项的逐项结论，每项附来源 URL",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "authenticity",
              "operating_status",
              "business_relevance",
              "risk_signals",
              "reachability"
            ],
            "description": "对应 due-diligence.md 的检查项：真实性/经营状态/业务相关性/风险信号/触达有效性"
          },
          "finding": {
            "type": "string",
            "description": "查到了什么、依据是什么；查无实据也如实记录"
          },
          "source": { "type": "string", "format": "uri" },
          "status": {
            "type": "string",
            "enum": ["confirmed", "inconclusive", "negative"],
            "description": "confirmed=证据支持；inconclusive=证据不足存疑；negative=证据否定或有风险信号"
          }
        },
        "required": ["check", "finding", "source", "status"]
      }
    },
    "estimated_annual_procurement_usd": {
      "type": "object",
      "description": "年采购额估算。无法估算时省略本字段（不要填假数字）；打分时用 score_breakdown.volume.tier=unknown 并在 volume.basis 说明原因",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "basis": { "type": "string" },
        "estimated_at": {
          "type": "string",
          "format": "date",
          "description": "估算所依据的公开数据日期；代理指标时效性强，复查时优先更新此项"
        }
      },
      "required": ["min", "max", "basis"]
    },
    "score": { "type": "number" },
    "score_breakdown": {
      "type": "object",
      "description": "四项得分与总分推导依据，打分必须可复核（公式见 segmentation.md）",
      "properties": {
        "fit": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "basis": { "type": "string", "description": "如：segment=importer，icp.type_weights.importer=3，fit=3/5" }
          },
          "required": ["value", "basis"]
        },
        "volume": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "tier": { "type": "string", "enum": ["A", "B", "C", "D", "unknown"] },
            "basis": { "type": "string", "description": "所用的代理指标与换算过程；unknown 时说明为何无法估算" }
          },
          "required": ["value", "basis"]
        },
        "activity": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "count": { "type": "integer", "description": "近 24 个月可查项目/新闻数" },
            "basis": { "type": "string", "description": "计数口径与来源" }
          },
          "required": ["value", "basis"]
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "contact_score": { "type": "number" },
            "decision_maker_score": { "type": "number" },
            "basis": { "type": "string", "description": "联系通道与决策人识别情况" }
          },
          "required": ["value", "basis"]
        },
        "region_weight": {
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "basis": { "type": "string", "description": "命中的 market.region_weights 条目；未命中按 1 并注明" }
          },
          "required": ["value", "basis"]
        }
      },
      "required": ["fit", "volume", "activity", "accessibility", "region_weight"]
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "due_diligence_summary": { "type": "string" },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": ["email", "phone", "linkedin", "website_form"]
          },
          "value": { "type": "string" },
          "role": { "type": "string" },
          "source": { "type": "string", "format": "uri" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "required": ["channel", "value", "source", "confidence"]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "priority": { "type": "integer" }
  },
  "required": ["company", "country", "sources", "stage", "disposition"],
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": ["competitor", "unreachable", "excluded"]
          }
        },
        "required": ["disposition"]
      },
      "then": { "required": ["exclusion_reason"] }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "competitor" } },
        "required": ["disposition"]
      },
      "then": {
        "required": ["segment_evidence"],
        "properties": {
          "segment_evidence": {
            "type": "array",
            "minItems": 1,
            "description": "至少一条 supply_side 证据（由 validate_candidates.py 再校验信号类型）"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "enum": ["main", "backup"] } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "stage": { "const": "scored" },
          "match_reason": { "type": "string", "minLength": 1 },
          "due_diligence_summary": { "type": "string", "minLength": 1 },
          "segment_evidence": {
            "type": "array",
            "minItems": 1,
            "description": "至少一条证据；交付态须含至少一条 demand_side（脚本硬校验）"
          },
          "due_diligence_checks": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "description": "五个检查项各一条，缺一不可"
          },
          "contacts": {
            "type": "array",
            "description": "可为 []（无公开联系方式时）；非空则每项必须有 source+confidence。空数组时 reachability 检查的 finding 须说明已检索且无公开通道"
          },
          "score_breakdown": {
            "type": "object",
            "required": ["fit", "volume", "activity", "accessibility", "region_weight"]
          }
        },
        "required": [
          "score",
          "score_breakdown",
          "risk_level",
          "segment",
          "match_reason",
          "segment_evidence",
          "due_diligence_checks",
          "due_diligence_summary",
          "contacts"
        ]
      }
    }
  ]
}
